# ========== LLM 配置 ==========
# 用哪个 provider，可选值：
#   siliconflow | openai | qwen | bailian
# 要和下面填了 Key 的那个保持一致，否则会拿空 Key 去请求。
LLM_PROVIDER=siliconflow

# 硅基流动（默认） https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# OpenAI / 任何 OpenAI 兼容接口（Ollama、vLLM 等）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 通义千问（阿里云 DashScope）
DASHSCOPE_API_KEY=sk-xxx
QWEN_MODEL=qwen-plus

# 阿里云百炼平台 https://bailian.console.aliyun.com/
BAILIAN_API_KEY=sk-xxx
BAILIAN_MODEL=qwen-plus

# ========== 数据库配置 ==========
# 默认用 SQLite：无需安装任何数据库，启动脚本会自动建好示例库。
DB_TYPE=sqlite
DB_SQLITE_PATH=./data/local.db

# 用 MySQL 就把上面两行注释掉，改成下面这几行。
# 建表/造数脚本见 README 的「初始化示例数据库」一节。
# 注意 scripts/init_db.sql 里有 DROP TABLE，别对着有真实数据的库跑。
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=your_database

# PostgreSQL 同理，把 DB_TYPE 改成 postgresql 并填下面几项。
# DB_TYPE=postgresql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=your_database

# ========== Agent 配置 ==========
# 重试次数、置信度阈值、查询日志路径等在 config/settings.yaml 里配置，
# 不通过 .env 设置。
